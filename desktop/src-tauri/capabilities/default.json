{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The bundled UI window: core APIs, the window controls of the custom title bar, events from the shell and native notifications. File transfer goes through the sidecar's loopback API, not Tauri plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-focused",
    "core:event:default",
    "notification:default"
  ]
}
